# Local Docker Compose configuration. Do not commit the matching .env file.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=interviewguard
JWT_SECRET=replace-with-a-long-random-secret

# Optional email delivery. Invitations still generate when these are blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Optional URL to real trained deepfake weights compatible with training/train.py.
MODEL_URL=

# Render backend environment variables (set these in Render, not this file):
# ENVIRONMENT=production
# DATABASE_URL=postgresql://...
# FRONTEND_BASE_URL=https://your-frontend.onrender.com
# INTERVIEW_BASE_URL=https://your-frontend.onrender.com
# FRONTEND_URLS=https://your-frontend.onrender.com
# MODEL_PATH=/app/models/deepfake_model.pth
# YOLO_MODEL_PATH=/app/models/yolov8n.pt
# Frontend BUILD arguments: VITE_API_URL=https://your-backend.onrender.com/api
# and VITE_SOCKET_URL=https://your-backend.onrender.com
